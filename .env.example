DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# Durable application object storage. Keep disabled for local development.
# USE_S3_STORAGE=False
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Signed-read URL lifetime in seconds.
# AWS_QUERYSTRING_EXPIRE=900
# Explicit regional virtual-hosted addressing for private S3 URLs.
# AWS_S3_ADDRESSING_STYLE=virtual

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:4201
CRM_FRONTEND_URL=http://localhost:4200
COMMUNITY_ACTIVATION_EXPIRY_HOURS=72
COMMUNITY_ACTIVATION_THROTTLE_RATE=10/hour
COMMUNITY_LOGIN_THROTTLE_RATE=10/hour
COMMUNITY_PASSWORD_RESET_THROTTLE_RATE=5/hour
COMMUNITY_DIRECTORY_THROTTLE_RATE=60/hour
# Local Community frontend origin.
COMMUNITY_FRONTEND_URL=http://localhost:4201

# Brevo Transactional Email API (backend-only; never expose this key to clients)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@elevatemk.org
